rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    function isApprovedUser() {
      return isSignedIn() && (role() == 'owner' || role() == 'staff');
    }

    // ผู้อ่าน (guest) รวมกับ owner/staff อ่านข้อมูลฝั่งเงินสด/กองทุน/รายงานได้ แต่สร้าง/แก้ไขไม่ได้
    // และมองไม่เห็นโมดูลโอนจ่ายธนาคารเลย (โมดูลนั้นยังคงเช็คด้วย isOwner() เท่านั้น)
    function canReadCash() {
      return isSignedIn() && (role() == 'owner' || role() == 'staff' || role() == 'guest');
    }

    // ---------- meta (ใช้เช็คว่ามีเจ้าของร้านคนแรกแล้วหรือยัง) ----------
    match /meta/setup {
      // อ่านได้แม้ยังไม่ล็อกอิน เพราะต้องเช็คตอนหน้าสมัครสมาชิกก่อนสร้างบัญชีด้วยซ้ำ
      allow read: if true;
      // สร้างได้ครั้งเดียวตอนบัญชีแรกของระบบสมัครสำเร็จ (ดู users create rule ด้านล่าง)
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // ---------- users ----------
    match /users/{userId} {
      // สร้างเอกสารได้ 2 กรณี:
      // 1) สมัครสมาชิกด้วยตัวเอง (self-registration) — เริ่มที่ pending เสมอ
      //    ยกเว้นเป็นคนแรกสุดของระบบ (ยังไม่มีเอกสาร meta/setup) จะตั้งตัวเองเป็น owner ได้ทันที
      //    เพื่อไม่ต้องเข้า Firebase Console ไปแก้ role ด้วยมือทุกครั้งที่ตั้งระบบใหม่
      // 2) เจ้าของร้านเพิ่มพนักงาน/ผู้อ่านให้โดยตรงจากหน้า "ผู้ใช้งาน" — ไม่ต้องรอ pending
      //    ตั้ง role ให้ตรงได้เลยตั้งแต่สร้าง (staff/guest/owner)
      allow create: if isSignedIn() && (
        (request.auth.uid == userId && (
          request.resource.data.role == 'pending' ||
          (request.resource.data.role == 'owner' &&
            !exists(/databases/$(database)/documents/meta/setup))
        ))
        ||
        (isOwner() && request.resource.data.role in ['staff', 'guest', 'owner'])
      );

      // อ่านได้เฉพาะเจ้าของบัญชีเอง หรือ owner (เพื่อจัดการสิทธิ์/แสดงชื่อผู้บันทึก)
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());

      // เปลี่ยน role ได้เฉพาะ owner เท่านั้น ห้ามผู้ใช้ตั้ง role ให้ตัวเอง
      allow update: if isOwner();

      allow delete: if false;
    }

    // ---------- transactions ----------
    match /transactions/{txId} {

      function coreFieldsUnchanged() {
        return request.resource.data.amount == resource.data.amount &&
          request.resource.data.withdrawnAmount == resource.data.withdrawnAmount &&
          request.resource.data.itemDescription == resource.data.itemDescription &&
          request.resource.data.changeAmount == resource.data.changeAmount &&
          request.resource.data.paymentMethod == resource.data.paymentMethod &&
          request.resource.data.note == resource.data.note;
      }

      function editHistoryGrewWithReason() {
        let newLen = request.resource.data.editHistory.size();
        return newLen == resource.data.editHistory.size() + 1 &&
          request.resource.data.editHistory[newLen - 1].editedBy == request.auth.uid &&
          request.resource.data.editHistory[newLen - 1].reason is string &&
          request.resource.data.editHistory[newLen - 1].reason.size() > 0;
      }

      // สร้างรายการใหม่ได้เฉพาะผู้ใช้ที่ได้รับอนุมัติ ต้องระบุตัวเองเป็นผู้สร้าง
      // เริ่มที่สถานะ pending เสมอ และห้ามใส่ประวัติแก้ไขมาตั้งแต่แรก
      allow create: if isApprovedUser()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.editHistory.size() == 0
        && request.resource.data.fundId is string;

      // อ่านได้เฉพาะเจ้าของรายการ, owner (เห็นทุกรายการเพื่อกำกับดูแล), หรือใครก็ตามที่อ่านข้อมูลฝั่งเงินสดได้
      // และรายการนั้นอนุมัติแล้ว (โปร่งใสให้ staff/guest เห็นภาพรวมเงินหมุนเวียนได้ แต่ไม่เห็นรายการที่ยังไม่ผ่านตรวจสอบของคนอื่น)
      allow read: if canReadCash() &&
        (isOwner() || resource.data.createdBy == request.auth.uid || resource.data.status == 'approved');

      allow update: if isSignedIn() && (
        // 1) owner ตรวจสอบอนุมัติ/ตีกลับ/ยกเลิก — แก้ได้เฉพาะสถานะและหมายเหตุตรวจสอบ ห้ามแตะตัวเลข/รายละเอียด
        //    อนุมัติสำเร็จ (เบิกได้จริง) ได้ก็ต่อเมื่อมีลายเซ็นออนไลน์แนบมาด้วยเท่านั้น
        (isOwner() && coreFieldsUnchanged() &&
          request.resource.data.editHistory.size() == resource.data.editHistory.size() &&
          request.resource.data.reviewedBy == request.auth.uid &&
          request.resource.data.fundId == resource.data.fundId &&
          (request.resource.data.status != 'approved' || request.resource.data.approvalSignatureURL is string))
        ||
        // 2) owner แก้ไขข้อมูลย้อนหลัง — ต้องมีเหตุผลและถูกบันทึกลง audit trail เสมอ
        (isOwner() &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.receiptPhotoURL == resource.data.receiptPhotoURL &&
          request.resource.data.fundId == resource.data.fundId &&
          editHistoryGrewWithReason())
        ||
        // 3) พนักงานแก้ไขรายการของตัวเองได้เฉพาะตอนยังไม่ถูกตรวจสอบ (pending)
        //    ห้ามแตะสถานะ วันที่สร้าง หรือรูปหลักฐาน ต้องมีเหตุผลทุกครั้ง
        (isApprovedUser() && role() == 'staff' &&
          resource.data.createdBy == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.receiptPhotoURL == resource.data.receiptPhotoURL &&
          request.resource.data.changePhotoURL == resource.data.changePhotoURL &&
          request.resource.data.fundId == resource.data.fundId &&
          editHistoryGrewWithReason())
      );

      // ห้ามลบรายการถาวรโดยเด็ดขาด แม้แต่ owner — ใช้สถานะ "voided" แทนเพื่อรักษาประวัติทั้งหมด
      allow delete: if false;
    }

    // ---------- funds (เงินหมุนเวียนแต่ละฝั่ง เช่น หน้าร้าน / ออกส่งสินค้าและเบี้ยเลี้ยง) ----------
    match /funds/{fundId} {
      // ทุกคนที่อ่านข้อมูลฝั่งเงินสดได้ (staff/owner/guest) อ่านได้ แต่สร้าง/แก้ได้เฉพาะ owner
      allow read: if canReadCash();
      allow create: if isOwner() && request.resource.data.openingBalance is number;
      allow update: if isOwner();
      allow delete: if false;
    }

    // ---------- fundTopups (การคีย์เงินรับเข้ากองทุนหมุนเวียน) ----------
    match /fundTopups/{topupId} {
      allow read: if canReadCash();
      // เติมเงินเข้ากองทุนได้เฉพาะ owner เท่านั้น และต้องระบุตัวเองเป็นผู้บันทึก
      allow create: if isOwner()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update: if false;
      allow delete: if false;
    }

    // ---------- โมดูลโอนจ่ายผ่านธนาคาร (เฉพาะแอดมิน/เจ้าของ ไม่เกี่ยวกับพนักงาน) ----------

    // เลขที่เอกสารรันอัตโนมัติ (ใบเบิก / ใบโอนจ่าย)
    match /counters/{counterId} {
      allow read, write: if isOwner();
    }

    // บัญชีธนาคารโปรด ทั้งฝั่งบัญชีของเรา (source) และบัญชีผู้รับโอน (payee)
    match /bankAccounts/{accountId} {
      allow read, write: if isOwner();
    }

    // หมวดหมู่โปรดสำหรับรายการในใบเบิก
    match /transferCategories/{categoryId} {
      allow read, write: if isOwner();
    }

    // ใบเบิกเงินโอน (เงินเข้าบัญชี A ก่อนนำไปจ่ายออก)
    match /withdrawalRequests/{requestId} {
      allow read, write: if isOwner();
    }

    // ใบโอนจ่าย (เงินออกจากบัญชี A ไปยังบัญชี B ตัดยอดกับใบเบิก)
    match /transferPayments/{paymentId} {
      allow read, write: if isOwner();
    }
    // ---------- pinDirectory (ผูก PIN -> บัญชี เพื่อให้หน้า Login ค้นหาอีเมลจาก PIN ได้ก่อนล็อกอิน) ----------
    match /pinDirectory/{pin} {
      // อ่านแบบระบุ PIN ตรงๆ ได้แม้ยังไม่ล็อกอิน (จำเป็นสำหรับหน้า Login) แต่ห้าม list ทั้ง collection
      // เพื่อไม่ให้ใครดึงรายชื่อ PIN ที่ถูกใช้ไปแล้วทั้งหมดออกไปได้
      allow get: if true;
      allow list: if false;
      // สร้างได้เฉพาะการผูก PIN เข้ากับบัญชีของตัวเอง (ตอนสมัคร หรือตอนเปลี่ยน PIN)
      // หรือ owner สร้างให้พนักงาน/ผู้อ่านที่เพิ่มเข้าระบบโดยตรงจากหน้า "ผู้ใช้งาน"
      // ถ้า PIN นั้นมีเจ้าของอยู่แล้ว คำขอนี้จะถูกตีความเป็น "update" ซึ่งไม่มี rule อนุญาต จึงถูกปฏิเสธอัตโนมัติ (กัน PIN ซ้ำ)
      allow create: if isSignedIn() && (request.resource.data.uid == request.auth.uid || isOwner());
      // ลบได้เฉพาะเจ้าของ PIN นั้นเอง (ใช้ตอนเปลี่ยน PIN ใหม่ ต้องลบอันเก่าทิ้ง)
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
